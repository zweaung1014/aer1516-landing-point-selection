<?xml version="1.0" ?>
<sdf version="1.9">
  <world name="crazysim_maze">
    <physics type="ode">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <real_time_update_rate>1000</real_time_update_rate>
    </physics>
    <plugin name='gz::sim::systems::Physics' filename='libgz-sim-physics-system.so'/>
    <plugin name='gz::sim::systems::UserCommands' filename='libgz-sim-user-commands-system.so'/>
    <plugin name='gz::sim::systems::SceneBroadcaster' filename='libgz-sim-scene-broadcaster-system.so'/>
    <plugin name='gz::sim::systems::Contact' filename='libgz-sim-contact-system.so'/>
    <plugin name='gz::sim::systems::Imu' filename='libgz-sim-imu-system.so'/>
    <plugin name='gz::sim::systems::AirPressure' filename='libgz-sim-air-pressure-system.so'/>
    <plugin name='gz::sim::systems::Sensors' filename='libgz-sim-sensors-system.so'>
      <render_engine>ogre2</render_engine>
    </plugin>
    <gravity>0 0 -9.80665</gravity>
    <magnetic_field>6e-06 2.3e-05 -4.2e-05</magnetic_field>
    <atmosphere type='adiabatic'/>
    <scene>
      <grid>false</grid>
      <ambient>0.4 0.4 0.4 1</ambient>
      <background>0.7 0.7 0.7 1</background>
      <shadows>true</shadows>
    </scene>

    <!-- ==== Ground plane ==== -->
    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.8 0.8 0.8 1</ambient>
            <diffuse>0.8 0.8 0.8 1</diffuse>
            <specular>0.8 0.8 0.8 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- ==== Lighting ==== -->
    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <direction>-0.5 0.1 -0.9</direction>
    </light>


    <!-- ==== Surrounding boundary (visual-only frame): 20 m × 12 m ==== -->
    <!-- X: -3 to 17 (biased toward +x), Y: -6 to 6                   -->
    <model name="boundary_frame">
      <static>true</static>

      <!-- Top edge (along X) -->
      <link name="edge_top">
        <pose>7 6 0.6 0 0 0</pose>
        <visual name="visual">
          <geometry>
            <box><size>20 0.05 1.2</size></box>
          </geometry>
          <material>
            <ambient>1 0.85 0 1</ambient>
            <diffuse>1 0.85 0 1</diffuse>
          </material>
        </visual>
      </link>

      <!-- Bottom edge (along X) -->
      <link name="edge_bottom">
        <pose>7 -6 0.6 0 0 0</pose>
        <visual name="visual">
          <geometry>
            <box><size>20 0.05 1.2</size></box>
          </geometry>
          <material>
            <ambient>1 0.85 0 1</ambient>
            <diffuse>1 0.85 0 1</diffuse>
          </material>
        </visual>
      </link>

      <!-- Left edge (along Y) -->
      <link name="edge_left">
        <pose>-3 0 0.6 0 0 0</pose>
        <visual name="visual">
          <geometry>
            <box><size>0.05 12 1.2</size></box>
          </geometry>
          <material>
            <ambient>1 0.85 0 1</ambient>
            <diffuse>1 0.85 0 1</diffuse>
          </material>
        </visual>
      </link>

      <!-- Right edge (along Y) -->
      <link name="edge_right">
        <pose>17 0 0.6 0 0 0</pose>
        <visual name="visual">
          <geometry>
            <box><size>0.05 12 1.2</size></box>
          </geometry>
          <material>
            <ambient>1 0.85 0 1</ambient>
            <diffuse>1 0.85 0 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Twin of elevation_map_publisher scenario:=maze (maps/maze.py, unchanged). Map
         15 x 5 m from (-0.5, -2.5). A 0.5 m wall at x 6.85-7.15, y -1.5 to 1.5, and 17
         poles of 0.2 x 0.2 m (3 m tall here; obstacles, infinitely tall, in the map).
         Reference goal (14.0, 0.0). -->
    <model name="wall">
      <static>true</static>
      <pose>7.0000 0.0000 0.2500 0 0.000000 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.3000 3.0000 0.5000</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.3000 3.0000 0.5000</size></box></geometry>
          <material>
            <ambient>0.5 0.5 0.5 1</ambient>
            <diffuse>0.5 0.5 0.5 1</diffuse>
          </material>
        </visual>
      </link>
    </model>
    <model name="pole_1">
