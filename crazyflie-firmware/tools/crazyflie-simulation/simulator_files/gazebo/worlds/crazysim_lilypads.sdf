      <static>true</static>
      <pose>2.0000 0.9000 0.9000 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><cylinder><radius>0.6000</radius><length>1.8000</length></cylinder></geometry>
        </collision>
