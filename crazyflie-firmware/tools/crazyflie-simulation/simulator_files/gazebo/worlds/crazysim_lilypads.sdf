<?xml version="1.0" ?>
<sdf version="1.9">
  <world name="crazysim_lilypads">
    <physics type="ode">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <real_time_update_rate>1000</real_time_update_rate>
    </physics>
    <plugin name='gz::sim::systems::Physics' filename='libgz-sim-physics-system.so'/>
    <plugin name='gz::sim::systems::UserCommands' filename='libgz-sim-user-commands-system.so'/>
    <plugin name='gz::sim::systems::SceneBroadcaster' filename='libgz-sim-scene-broadcaster-system.so'/>
    <plugin name='gz::sim::systems::Contact' filename='libgz-sim-contact-system.so'/>
    <plugin name='gz::sim::systems::Imu' filename='libgz-sim-imu-system.so'/>
    <plugin name='gz::sim::systems::AirPressure' filename='libgz-sim-air-pressure-system.so'/>
    <plugin name='gz::sim::systems::Sensors' filename='libgz-sim-sensors-system.so'>
      <render_engine>ogre2</render_engine>
    </plugin>
    <gravity>0 0 -9.80665</gravity>
    <magnetic_field>6e-06 2.3e-05 -4.2e-05</magnetic_field>
    <atmosphere type='adiabatic'/>
    <scene>
      <grid>false</grid>
      <ambient>0.4 0.4 0.4 1</ambient>
      <background>0.7 0.7 0.7 1</background>
      <shadows>true</shadows>
    </scene>

    <!-- ==== Ground plane ==== -->
    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.8 0.8 0.8 1</ambient>
            <diffuse>0.8 0.8 0.8 1</diffuse>
            <specular>0.8 0.8 0.8 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- ==== Lighting ==== -->
    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <direction>-0.5 0.1 -0.9</direction>
    </light>


    <!-- ==== Surrounding boundary (visual-only frame): 18 m x 8 m ==== -->
    <!-- X: -3 to 15, Y: -4 to 4                                       -->
    <model name="boundary_frame">
      <static>true</static>
      <link name="edge_top">
        <pose>6 4 0.6 0 0 0</pose>
        <visual name="visual">
          <geometry>
            <box><size>18 0.05 1.2</size></box>
          </geometry>
          <material>
            <ambient>1 0.85 0 1</ambient>
            <diffuse>1 0.85 0 1</diffuse>
          </material>
        </visual>
      </link>
      <link name="edge_bottom">
        <pose>6 -4 0.6 0 0 0</pose>
        <visual name="visual">
          <geometry>
            <box><size>18 0.05 1.2</size></box>
          </geometry>
          <material>
            <ambient>1 0.85 0 1</ambient>
            <diffuse>1 0.85 0 1</diffuse>
          </material>
        </visual>
      </link>
      <link name="edge_left">
        <pose>-3 0 0.6 0 0 0</pose>
        <visual name="visual">
          <geometry>
            <box><size>0.05 8 1.2</size></box>
          </geometry>
          <material>
            <ambient>1 0.85 0 1</ambient>
            <diffuse>1 0.85 0 1</diffuse>
          </material>
        </visual>
      </link>
      <link name="edge_right">
        <pose>15 0 0.6 0 0 0</pose>
        <visual name="visual">
          <geometry>
            <box><size>0.05 8 1.2</size></box>
          </geometry>
          <material>
            <ambient>1 0.85 0 1</ambient>
            <diffuse>1 0.85 0 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Twin of elevation_map_publisher scenario:=lilypads (no reference file). Map
         16 x 6 m from (-2, -3). Two 2.0 m platforms 10 m apart: start x -1.5 to 1.0,
         y -2 to 2 (the robot spawns at (0, 0); launch with -z 3.4) and goal x 11.0 to
         12.5, y -1.5 to 1.5, goal (11.75, 0). Between them 20 cylindrical pads, 1.8-2.2 m
         tall, r 0.35-0.75 m. The rest is ground at 0. -->
    <model name="start_platform">
      <static>true</static>
      <pose>-0.2500 0.0000 1.0000 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>2.5000 4.0000 2.0000</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>2.5000 4.0000 2.0000</size></box></geometry>
          <material>
            <ambient>0.55 0.5 0.45 1</ambient>
            <diffuse>0.55 0.5 0.45 1</diffuse>
          </material>
        </visual>
      </link>
    </model>
    <model name="goal_platform">
      <static>true</static>
      <pose>11.7500 0.0000 1.0000 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>1.5000 3.0000 2.0000</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>1.5000 3.0000 2.0000</size></box></geometry>
          <material>
            <ambient>0.55 0.5 0.45 1</ambient>
            <diffuse>0.55 0.5 0.45 1</diffuse>
          </material>
        </visual>
      </link>
    </model>
