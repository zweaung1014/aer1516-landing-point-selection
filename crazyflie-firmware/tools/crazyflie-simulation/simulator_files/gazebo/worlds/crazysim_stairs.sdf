<?xml version="1.0" ?>
<sdf version="1.9">
  <world name="crazysim_stairs">
    <physics type="ode">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <real_time_update_rate>1000</real_time_update_rate>
    </physics>
    <plugin name='gz::sim::systems::Physics' filename='libgz-sim-physics-system.so'/>
    <plugin name='gz::sim::systems::UserCommands' filename='libgz-sim-user-commands-system.so'/>
    <plugin name='gz::sim::systems::SceneBroadcaster' filename='libgz-sim-scene-broadcaster-system.so'/>
    <plugin name='gz::sim::systems::Contact' filename='libgz-sim-contact-system.so'/>
    <plugin name='gz::sim::systems::Imu' filename='libgz-sim-imu-system.so'/>
    <plugin name='gz::sim::systems::AirPressure' filename='libgz-sim-air-pressure-system.so'/>
    <plugin name='gz::sim::systems::Sensors' filename='libgz-sim-sensors-system.so'>
      <render_engine>ogre2</render_engine>
    </plugin>
    <gravity>0 0 -9.80665</gravity>
    <magnetic_field>6e-06 2.3e-05 -4.2e-05</magnetic_field>
    <atmosphere type='adiabatic'/>
    <scene>
      <grid>false</grid>
      <ambient>0.4 0.4 0.4 1</ambient>
      <background>0.7 0.7 0.7 1</background>
      <shadows>true</shadows>
    </scene>

    <!-- ==== Ground plane ==== -->
    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.8 0.8 0.8 1</ambient>
            <diffuse>0.8 0.8 0.8 1</diffuse>
            <specular>0.8 0.8 0.8 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- ==== Lighting ==== -->
    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <direction>-0.5 0.1 -0.9</direction>
    </light>


    <!-- ==== Surrounding boundary (visual-only frame): 20 m × 12 m ==== -->
    <!-- X: -3 to 17 (biased toward +x), Y: -6 to 6                   -->
    <model name="boundary_frame">
      <static>true</static>

      <!-- Top edge (along X) -->
      <link name="edge_top">
        <pose>7 6 0.6 0 0 0</pose>
        <visual name="visual">
          <geometry>
            <box><size>20 0.05 1.2</size></box>
          </geometry>
          <material>
            <ambient>1 0.85 0 1</ambient>
            <diffuse>1 0.85 0 1</diffuse>
          </material>
        </visual>
      </link>

      <!-- Bottom edge (along X) -->
      <link name="edge_bottom">
        <pose>7 -6 0.6 0 0 0</pose>
        <visual name="visual">
          <geometry>
            <box><size>20 0.05 1.2</size></box>
          </geometry>
          <material>
            <ambient>1 0.85 0 1</ambient>
            <diffuse>1 0.85 0 1</diffuse>
          </material>
        </visual>
      </link>

      <!-- Left edge (along Y) -->
      <link name="edge_left">
        <pose>-3 0 0.6 0 0 0</pose>
        <visual name="visual">
          <geometry>
            <box><size>0.05 12 1.2</size></box>
          </geometry>
          <material>
            <ambient>1 0.85 0 1</ambient>
            <diffuse>1 0.85 0 1</diffuse>
          </material>
        </visual>
      </link>

      <!-- Right edge (along Y) -->
      <link name="edge_right">
        <pose>17 0 0.6 0 0 0</pose>
        <visual name="visual">
          <geometry>
            <box><size>0.05 12 1.2</size></box>
          </geometry>
          <material>
            <ambient>1 0.85 0 1</ambient>
            <diffuse>1 0.85 0 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Twin of elevation_map_publisher scenario:=stairs (maps/stairs.py resized to human
         stairs: eight 0.18 m risers on 0.3 m treads). Map 5 x 5 m from (-0.5, -4.5). Steps at
         x 1.0 / 1.3 / ... / 3.1, the top (1.44 m) to the map edge at x 4.5; y -3.5 to -0.5,
         flat margins either side. Reference goal (4.0, -2.0). -->
    <model name="step_1">
      <static>true</static>
      <pose>1.1500 -2.0000 0.0900 0 0.000000 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.3000 3.0000 0.1800</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.3000 3.0000 0.1800</size></box></geometry>
          <material>
            <ambient>0.78 0.78 0.78 1</ambient>
            <diffuse>0.78 0.78 0.78 1</diffuse>
          </material>
        </visual>
      </link>
    </model>
    <model name="step_2">
      <static>true</static>
      <pose>1.4500 -2.0000 0.1800 0 0.000000 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.3000 3.0000 0.3600</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.3000 3.0000 0.3600</size></box></geometry>
          <material>
            <ambient>0.73 0.73 0.73 1</ambient>
            <diffuse>0.73 0.73 0.73 1</diffuse>
          </material>
        </visual>
      </link>
    </model>
    <model name="step_3">
      <static>true</static>
      <pose>1.7500 -2.0000 0.2700 0 0.000000 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.3000 3.0000 0.5400</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.3000 3.0000 0.5400</size></box></geometry>
          <material>
            <ambient>0.68 0.68 0.68 1</ambient>
            <diffuse>0.68 0.68 0.68 1</diffuse>
          </material>
        </visual>
      </link>
    </model>
    <model name="step_4">
      <static>true</static>
      <pose>2.0500 -2.0000 0.3600 0 0.000000 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.3000 3.0000 0.7200</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.3000 3.0000 0.7200</size></box></geometry>
          <material>
            <ambient>0.63 0.63 0.63 1</ambient>
            <diffuse>0.63 0.63 0.63 1</diffuse>
          </material>
        </visual>
      </link>
    </model>
    <model name="step_5">
      <static>true</static>
      <pose>2.3500 -2.0000 0.4500 0 0.000000 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.3000 3.0000 0.9000</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.3000 3.0000 0.9000</size></box></geometry>
          <material>
            <ambient>0.58 0.58 0.58 1</ambient>
            <diffuse>0.58 0.58 0.58 1</diffuse>
          </material>
        </visual>
      </link>
    </model>
    <model name="step_6">
      <static>true</static>
      <pose>2.6500 -2.0000 0.5400 0 0.000000 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.3000 3.0000 1.0800</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.3000 3.0000 1.0800</size></box></geometry>
          <material>
            <ambient>0.53 0.53 0.53 1</ambient>
            <diffuse>0.53 0.53 0.53 1</diffuse>
          </material>
        </visual>
      </link>
    </model>
    <model name="step_7">
      <static>true</static>
      <pose>2.9500 -2.0000 0.6300 0 0.000000 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.3000 3.0000 1.2600</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.3000 3.0000 1.2600</size></box></geometry>
          <material>
            <ambient>0.48 0.48 0.48 1</ambient>
            <diffuse>0.48 0.48 0.48 1</diffuse>
          </material>
        </visual>
      </link>
    </model>
    <model name="step_8">
      <static>true</static>
      <pose>3.8000 -2.0000 0.7200 0 0.000000 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>1.4000 3.0000 1.4400</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>1.4000 3.0000 1.4400</size></box></geometry>
          <material>
            <ambient>0.43 0.43 0.43 1</ambient>
            <diffuse>0.43 0.43 0.43 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

  </world>
</sdf>
