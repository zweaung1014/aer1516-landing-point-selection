<?xml version="1.0" ?>
<sdf version="1.9">
  <world name="crazysim_floating_platforms">
    <physics type="ode">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <real_time_update_rate>1000</real_time_update_rate>
    </physics>
    <plugin name='gz::sim::systems::Physics' filename='libgz-sim-physics-system.so'/>
    <plugin name='gz::sim::systems::UserCommands' filename='libgz-sim-user-commands-system.so'/>
    <plugin name='gz::sim::systems::SceneBroadcaster' filename='libgz-sim-scene-broadcaster-system.so'/>
    <plugin name='gz::sim::systems::Contact' filename='libgz-sim-contact-system.so'/>
    <plugin name='gz::sim::systems::Imu' filename='libgz-sim-imu-system.so'/>
    <plugin name='gz::sim::systems::AirPressure' filename='libgz-sim-air-pressure-system.so'/>
    <plugin name='gz::sim::systems::Sensors' filename='libgz-sim-sensors-system.so'>
      <render_engine>ogre2</render_engine>
    </plugin>
    <gravity>0 0 -9.80665</gravity>
    <magnetic_field>6e-06 2.3e-05 -4.2e-05</magnetic_field>
    <atmosphere type='adiabatic'/>
    <scene>
      <grid>false</grid>
      <ambient>0.4 0.4 0.4 1</ambient>
      <background>0.7 0.7 0.7 1</background>
      <shadows>true</shadows>
    </scene>

    <!-- ==== Ground plane ==== -->
    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.8 0.8 0.8 1</ambient>
            <diffuse>0.8 0.8 0.8 1</diffuse>
            <specular>0.8 0.8 0.8 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- ==== Lighting ==== -->
    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <direction>-0.5 0.1 -0.9</direction>
    </light>


    <!-- ==== Surrounding boundary (visual-only frame): 8.5 m x 8.0 m ==== -->
    <!-- X: -1.5 to 7.0, Y: -3.0 to 5.0 (the map's extent)                  -->
    <model name="boundary_frame">
      <static>true</static>
      <link name="edge_top">
        <pose>2.75 5.0 0.6 0 0 0</pose>
        <visual name="visual">
          <geometry>
            <box><size>8.5 0.05 1.2</size></box>
          </geometry>
          <material>
            <ambient>1 0.85 0 1</ambient>
            <diffuse>1 0.85 0 1</diffuse>
          </material>
        </visual>
      </link>
      <link name="edge_bottom">
        <pose>2.75 -3.0 0.6 0 0 0</pose>
        <visual name="visual">
          <geometry>
            <box><size>8.5 0.05 1.2</size></box>
          </geometry>
          <material>
            <ambient>1 0.85 0 1</ambient>
            <diffuse>1 0.85 0 1</diffuse>
          </material>
        </visual>
      </link>
      <link name="edge_left">
        <pose>-1.5 1.0 0.6 0 0 0</pose>
        <visual name="visual">
          <geometry>
            <box><size>0.05 8.0 1.2</size></box>
          </geometry>
          <material>
            <ambient>1 0.85 0 1</ambient>
            <diffuse>1 0.85 0 1</diffuse>
          </material>
        </visual>
      </link>
      <link name="edge_right">
        <pose>7.0 1.0 0.6 0 0 0</pose>
        <visual name="visual">
          <geometry>
            <box><size>0.05 8.0 1.2</size></box>
          </geometry>
          <material>
            <ambient>1 0.85 0 1</ambient>
            <diffuse>1 0.85 0 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Twin of elevation_map_publisher scenario:=floating_platforms (no reference file).
         Map 8.5 x 8 m from (-1.5, -3). The robot starts on the ground at (0, 0) (default
         spawn height). Thirteen floating 0.1 m slabs; each slab's top face is the map's
         height over its footprint (edges on multiples of 0.1 m). Route platforms A-I climb
         to the 3.0 m top at (5.6, 1.0), the goal; X1-X3 are dead ends. The map treats each
         platform as a column to the ground, so nothing plans under one. -->
    <model name="platform_A">
      <static>true</static>
      <pose>1.4000 0.2000 0.3000 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>1.0000 1.0000 0.1000</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>1.0000 1.0000 0.1000</size></box></geometry>
          <material>
            <ambient>0.22 0.47 0.71 1</ambient>
            <diffuse>0.22 0.47 0.71 1</diffuse>
          </material>
        </visual>
      </link>
    </model>
    <model name="platform_B">
      <static>true</static>
      <pose>2.6000 -0.9000 0.7000 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>1.0000 0.8000 0.1000</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>1.0000 0.8000 0.1000</size></box></geometry>
          <material>
            <ambient>0.25 0.50 0.68 1</ambient>
            <diffuse>0.25 0.50 0.68 1</diffuse>
          </material>
        </visual>
      </link>
    </model>
    <model name="platform_C">
      <static>true</static>
      <pose>3.9000 -0.3000 0.5500 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>1.0000 0.8000 0.1000</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>1.0000 0.8000 0.1000</size></box></geometry>
          <material>
            <ambient>0.24 0.49 0.69 1</ambient>
            <diffuse>0.24 0.49 0.69 1</diffuse>
          </material>
        </visual>
      </link>
    </model>
    <model name="platform_D">
      <static>true</static>
      <pose>3.6000 1.2000 1.0000 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.8000 0.8000 0.1000</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.8000 0.8000 0.1000</size></box></geometry>
          <material>
            <ambient>0.27 0.52 0.65 1</ambient>
            <diffuse>0.27 0.52 0.65 1</diffuse>
          </material>
        </visual>
      </link>
    </model>
    <model name="platform_E">
      <static>true</static>
      <pose>2.2000 1.6000 1.3500 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>1.0000 0.8000 0.1000</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>1.0000 0.8000 0.1000</size></box></geometry>
          <material>
            <ambient>0.29 0.54 0.61 1</ambient>
            <diffuse>0.29 0.54 0.61 1</diffuse>
          </material>
        </visual>
      </link>
    </model>
    <model name="platform_F">
      <static>true</static>
      <pose>1.0000 2.4000 1.6000 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.8000 1.0000 0.1000</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.8000 1.0000 0.1000</size></box></geometry>
          <material>
            <ambient>0.31 0.56 0.58 1</ambient>
            <diffuse>0.31 0.56 0.58 1</diffuse>
          </material>
        </visual>
      </link>
    </model>
    <model name="platform_G">
      <static>true</static>
      <pose>2.0000 3.4000 2.0500 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>1.0000 0.8000 0.1000</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>1.0000 0.8000 0.1000</size></box></geometry>
          <material>
            <ambient>0.34 0.59 0.54 1</ambient>
            <diffuse>0.34 0.59 0.54 1</diffuse>
          </material>
        </visual>
      </link>
    </model>
    <model name="platform_H">
      <static>true</static>
      <pose>3.5000 3.0000 2.2000 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.8000 0.8000 0.1000</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.8000 0.8000 0.1000</size></box></geometry>
          <material>
            <ambient>0.35 0.60 0.53 1</ambient>
            <diffuse>0.35 0.60 0.53 1</diffuse>
          </material>
        </visual>
      </link>
    </model>
    <model name="platform_I">
      <static>true</static>
      <pose>4.8000 2.4000 2.5500 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>1.0000 0.8000 0.1000</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>1.0000 0.8000 0.1000</size></box></geometry>
          <material>
            <ambient>0.37 0.62 0.49 1</ambient>
            <diffuse>0.37 0.62 0.49 1</diffuse>
          </material>
        </visual>
      </link>
    </model>
    <model name="platform_top">
      <static>true</static>
      <pose>5.6000 1.0000 2.9500 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>1.2000 1.2000 0.1000</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>1.2000 1.2000 0.1000</size></box></geometry>
          <material>
            <ambient>0.9 0.7 0.1 1</ambient>
            <diffuse>0.9 0.7 0.1 1</diffuse>
          </material>
        </visual>
      </link>
    </model>
    <model name="platform_X1">
      <static>true</static>
      <pose>5.2000 -1.4000 0.9500 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.8000 0.8000 0.1000</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.8000 0.8000 0.1000</size></box></geometry>
          <material>
            <ambient>0.6 0.3 0.3 1</ambient>
